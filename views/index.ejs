<% layout("/layouts/boilerplate")%> <%=success %>
<body>
    <!-- <h3>All listings</h3> -->
    <!-- <form method="GET" action="/listings/new">
        <button>create New listing</button>
    </form> -->

    <style>
      /* ===== FILTER BAR CONTAINER ===== */
#filters {
    display: flex;
    flex-wrap: wrap;        /* Allows wrapping to next line if needed */
    justify-content: flex-start;
    align-items: center;
    gap: 1.5rem;            /* Equal spacing between filters */
    padding: 0.75rem 1rem;
    background-color: #fff; /* White background for clarity */
    border-bottom: 1px solid #ddd;
    box-sizing: border-box;
}

/* ===== INDIVIDUAL FILTER ===== */
.filter {
    display: flex;
    flex-direction: column; /* Icon on top, text below */
    align-items: center;
    justify-content: center;
    min-width: 60px;        /* Consistent size for balance */
    text-align: center;
    color: #555;
    transition: all 0.2s ease-in-out;
    opacity: 0.8;
}

.filter:hover {
    opacity: 1;
    color: #000;
    transform: scale(1.05);
    cursor: pointer;
}

/* ===== FILTER ICON ===== */
.filter i {
    font-size: 1.6rem;
    margin-bottom: 0.25rem;
}

/* ===== FILTER LABEL ===== */
.filter p {
    font-size: 0.8rem;
    line-height: 1.2;
    margin: 0;
    word-wrap: break-word;
}

/* ===== TAX TOGGLE BUTTON ===== */
.tax-toggle {
    /* margin-left: auto;      /* Pushes it to far right */
    /* display: flex;
    align-items: center;
    gap: 0.5rem; */ 
    border: 1px solid black;
    border-radius: 1rem;
    height: 2.5rem;
    padding: 1rem;
    margin-left: 1rem;
    display: flex;
    align-items: center;
}

.tax-toggle input[type="checkbox"] {
    transform: scale(1.2); /* Bigger toggle */
    cursor: pointer;
}

/* ===== RESPONSIVE BEHAVIOR ===== */
@media (max-width: 768px) {
    #filters {
        gap: 1rem;
    }
    .filter i {
        font-size: 1.4rem;
    }
    .filter p {
        font-size: 0.75rem;
    }
}

@media (max-width: 480px) {
    #filters {
        justify-content: center; /* Center filters on very small screens */
    }
}

.taxinfo{
    display: none;
}

    </style>


    <div id="filters">
        <div class="filter">
          <div><i class="fa-solid fa-fire"></i></div>
             <p>Trending</p> 
        </div>

        <div class="filter">
          <div><i class="fa-solid fa-mountain-city"></i></div>
             <p>Iconic city</p> 
        </div>

         <div class="filter">
          <div><i class="fa-solid fa-mountain"></i></div>
             <p>Mountain</p> 
        </div>

         <div class="filter">
          <div><i class="fa-solid fa-chess-rook"></i></div>
             <p>Castles</p> 
        </div>
    
        <div class="filter">
          <div><i class="fa-solid fa-person-swimming"></i></div>
             <p>rooms</p> 
        </div>

         <div class="filter">
          <div><i class="fa-solid fa-hotel"></i></div>
             <p>rooms</p> 
        </div>
 <!-- more -->
         <div class="filter">
          <div><i class="fa-solid fa-campground"></i></div>
             <p>Camping</p> 
        </div>
    
        <div class="filter">
          <div><i class="fa-solid fa-cow"></i></i></div>
             <p>farms</p> 
        </div>

         <div class="filter">
          <div><i class="fa-solid fa-snowflake"></i></i></div>
             <p>Arctic</p> 
        </div>

        <!-- moremore -->
          <div class="filter">
          <div><i class="fa-solid fa-landmark-dome"></i></div>
             <p>Domes</p> 
        </div>
    
        <div class="filter">
          <div><i class="fa-solid fa-cow"></i></i></div>
             <p>farms</p> 
        </div>

         <div class="filter">
          <div><i class="fa-solid fa-snowflake"></i></i></div>
             <p>Arctic</p> 
        </div>

        <div class="tax-toggle">
            <div class="form-check-reverse form-switch">
            <input class="form-check-input mt-3" type="checkbox" role="switch" id="switchCheckDefault">
            <label class="form-check-label mt-3" for="switchCheckDefault">Display total after taxes</label>
            </div>
        </div>

    </div>
    <div class="row row-cols-lg-3 row-cols-md-3 row-cols-sm-1 mt-3">
        <% for( let listing of allistings) {%>
            <a href="/listings/<%= listing._id %>" class="listing-link">
           <div class="card col listing-card" >
           <img src="<%=  listing.image.url %>" class="card-img-top" alt="listing_image" style="height: 20rem;"/>
           <div class="card-img-overlay"> new images</div>
          <div class="card-body">
          <p class="card-text">
            <b> <%=  listing.title %></b> <br/>
             &#8377; <%=listing.price.toLocaleString("en-IN")%>/night
             <i class="taxinfo">&nbsp; &nbsp;+18% GST </i>
          </p>
         </div>
        </div>
        </a>
    <% } %>

    </div>
</body>

<script>
    let taxSwitch = document.getElementById("switchCheckDefault");
    taxSwitch.addEventListener("click",()=>{
        let taxInfo =  document.getElementsByClassName("taxinfo");
       for(info  of taxInfo ){
        if(info.style.display != "inline"){
             info.style.display = "inline";
        }else{
             info.style.display = "none";
        }
       
       }
    });
</script>
